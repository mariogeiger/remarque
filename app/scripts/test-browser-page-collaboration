#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "pillow>=11.0",
#   "selenium>=4.30",
# ]
# ///

from __future__ import annotations

import hashlib
import http.client
import io
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import tempfile
import time
from urllib.error import URLError
from urllib.request import Request, urlopen

from PIL import Image, ImageChops
from selenium import webdriver
from selenium.webdriver.common.action_chains import ActionChains
from selenium.webdriver.common.by import By
from selenium.webdriver.firefox.options import Options
from selenium.webdriver.firefox.service import Service
from selenium.webdriver.support.ui import WebDriverWait


OWNER_TOKEN = "browser-test-owner-token-with-at-least-32-bytes"


def unused_port() -> int:
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def wait_for_health(origin: str) -> None:
    for _ in range(100):
        try:
            with urlopen(f"{origin}/health", timeout=0.2) as response:
                if response.status == 200:
                    return
        except (OSError, URLError, http.client.HTTPException):
            time.sleep(0.05)
    raise RuntimeError("page relay did not become healthy")


def create_share(origin: str) -> str:
    body = json.dumps(
        {
            "snapshot": {
                "identity": {"document_id": "browser-test", "page_index": 0},
                "dimensions": {"width": 600, "height": 800},
                "background": None,
                "strokes": [],
                "active_strokes": [],
                "revision": 0,
            }
        }
    ).encode()
    request = Request(
        f"{origin}/api/shares",
        data=body,
        headers={
            "authorization": f"Bearer {OWNER_TOKEN}",
            "content-type": "application/json",
        },
        method="POST",
    )
    with urlopen(request) as response:
        guest_url = json.load(response)["guest_url"]
    return f"{origin}/#{guest_url.split('#', 1)[1]}"


def firefox() -> webdriver.Firefox:
    options = Options()
    options.add_argument("-headless")
    service = Service(shutil.which("geckodriver") or "/snap/bin/geckodriver")
    browser = webdriver.Firefox(options=options, service=service)
    browser.set_window_size(900, 1000)
    return browser


def wait_until_connected(browser: webdriver.Firefox) -> None:
    WebDriverWait(browser, 20).until(
        lambda current: current.find_element(By.ID, "status").text == "Connecté"
        and current.find_element(By.ID, "page").get_attribute("width") != "1"
    )


def canvas_png(browser: webdriver.Firefox) -> bytes:
    return browser.find_element(By.ID, "page").screenshot_as_png


def canvas_digest(browser: webdriver.Firefox) -> str:
    return hashlib.sha256(canvas_png(browser)).hexdigest()


def wait_for_canvas_change(browser: webdriver.Firefox, before: str) -> None:
    WebDriverWait(browser, 10).until(lambda _: canvas_digest(browser) != before)


def draw_horizontal_stroke(browser: webdriver.Firefox, y_offset: int) -> tuple[bytes, bytes]:
    before = canvas_png(browser)
    before_digest = hashlib.sha256(before).hexdigest()
    canvas = browser.find_element(By.ID, "page")
    ActionChains(browser).move_to_element(canvas).move_by_offset(
        -100, y_offset
    ).click_and_hold().move_by_offset(200, 0).release().perform()
    wait_for_canvas_change(browser, before_digest)
    if browser.find_element(By.ID, "status").text != "Connecté":
        raise AssertionError(browser.find_element(By.ID, "status").text)
    return before, canvas_png(browser)


def changed_height(before: bytes, after: bytes) -> int:
    before_image = Image.open(io.BytesIO(before)).convert("RGB")
    after_image = Image.open(io.BytesIO(after)).convert("RGB")
    bounds = ImageChops.difference(before_image, after_image).getbbox()
    if bounds is None:
        return 0
    return bounds[3] - bounds[1]


def erase_horizontal_stroke(browser: webdriver.Firefox, y_offset: int) -> None:
    eraser = browser.find_element(By.ID, "eraser")
    if eraser.get_attribute("aria-pressed") != "true":
        eraser.click()
    before = canvas_digest(browser)
    canvas = browser.find_element(By.ID, "page")
    ActionChains(browser).move_to_element(canvas).move_by_offset(
        -100, y_offset
    ).click_and_hold().move_by_offset(200, 0).release().perform()
    wait_for_canvas_change(browser, before)
    if eraser.get_attribute("aria-pressed") != "true":
        raise AssertionError("eraser did not remain selected after its gesture")


def run_browser_scenarios(origin: str, capability: str, restart_relay) -> None:
    first_profile = firefox()
    second_profile = firefox()
    try:
        first_profile.get(capability)
        wait_until_connected(first_profile)
        first_tab = first_profile.current_window_handle
        first_token = first_profile.execute_script(
            "return Object.values(localStorage)[0]"
        )

        first_profile.find_element(By.CSS_SELECTOR, '[data-thickness="0"]').click()
        thin_before, thin_after = draw_horizontal_stroke(first_profile, -150)
        first_profile.find_element(By.CSS_SELECTOR, '[data-thickness="3"]').click()
        thick_before, thick_after = draw_horizontal_stroke(first_profile, -90)
        if changed_height(thick_before, thick_after) <= changed_height(
            thin_before, thin_after
        ):
            raise AssertionError("extra-thick stroke was not wider than the thin stroke")

        erase_horizontal_stroke(first_profile, -90)
        first_profile.find_element(By.CSS_SELECTOR, '[data-thickness="2"]').click()
        if first_profile.find_element(By.ID, "eraser").get_attribute(
            "aria-pressed"
        ) != "false":
            raise AssertionError("selecting a fineliner thickness did not leave eraser mode")
        draw_horizontal_stroke(first_profile, -30)

        first_profile.switch_to.new_window("tab")
        first_profile.get(capability)
        wait_until_connected(first_profile)
        same_profile_token = first_profile.execute_script(
            "return Object.values(localStorage)[0]"
        )
        if same_profile_token != first_token:
            raise AssertionError("tabs in one browser profile received different identities")
        draw_horizontal_stroke(first_profile, 30)

        first_profile.refresh()
        wait_until_connected(first_profile)
        draw_horizontal_stroke(first_profile, 90)

        restart_relay()
        wait_until_connected(first_profile)
        draw_horizontal_stroke(first_profile, 150)

        second_profile.get(capability)
        wait_until_connected(second_profile)
        second_token = second_profile.execute_script(
            "return Object.values(localStorage)[0]"
        )
        if second_token == first_token:
            raise AssertionError("separate browser profiles received the same identity")

        second_tab = first_profile.current_window_handle
        local_before = canvas_digest(first_profile)
        first_profile.switch_to.window(first_tab)
        remote_before = canvas_digest(first_profile)
        first_profile.switch_to.window(second_tab)
        first_profile.find_element(By.ID, "eraser").click()
        canvas = first_profile.find_element(By.ID, "page")
        ActionChains(first_profile).move_to_element(canvas).move_by_offset(
            -80, 30
        ).click_and_hold().move_by_offset(160, 0).perform()
        wait_for_canvas_change(first_profile, local_before)
        first_profile.switch_to.window(first_tab)
        time.sleep(0.3)
        if canvas_digest(first_profile) != remote_before:
            raise AssertionError("eraser preview reached another tab before commit")
        first_profile.switch_to.window(second_tab)
        ActionChains(first_profile).release().perform()
        first_profile.switch_to.window(first_tab)
        wait_for_canvas_change(first_profile, remote_before)
    finally:
        first_profile.quit()
        second_profile.quit()


def main() -> None:
    workspace = Path(__file__).resolve().parents[2]
    with tempfile.TemporaryDirectory(prefix="remarque-browser-test-") as temporary:
        root = Path(temporary)
        viewer_root = root / "viewer"
        release = viewer_root / "releases" / "browser-test"
        release.mkdir(parents=True)
        subprocess.run(
            [
                workspace / "app/scripts/build-browser-page-renderer",
                release,
                "/wasm/releases/browser-test",
            ],
            check=True,
        )
        (viewer_root / "current").symlink_to("releases/browser-test")
        subprocess.run(
            [
                "cargo",
                "build",
                "--manifest-path",
                workspace / "Cargo.toml",
                "--package",
                "remarque-page-relay",
            ],
            check=True,
        )

        port = unused_port()
        origin = f"http://127.0.0.1:{port}"
        environment = os.environ.copy()
        environment.update(
            {
                "REMARQUE_RELAY_LISTEN": f"127.0.0.1:{port}",
                "REMARQUE_RELAY_PUBLIC_ORIGIN": "https://remarque.invalid",
                "REMARQUE_RELAY_DATA_DIR": str(root / "data"),
                "REMARQUE_RELAY_VIEWER_DIR": str(viewer_root),
                "REMARQUE_RELAY_OWNER_TOKEN": OWNER_TOKEN,
            }
        )
        relay = None

        def start_relay() -> None:
            nonlocal relay
            relay = subprocess.Popen(
                [workspace / "target/debug/remarque-page-relay"],
                env=environment,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            wait_for_health(origin)

        def stop_relay() -> None:
            nonlocal relay
            if relay is None:
                return
            relay.terminate()
            relay.wait(timeout=5)
            relay = None

        def restart_relay() -> None:
            stop_relay()
            start_relay()

        try:
            start_relay()
            capability = create_share(origin)
            run_browser_scenarios(origin, capability, restart_relay)
        finally:
            stop_relay()

    print(
        "browser collaboration passed: persistent eraser, thickness, erase→draw, profile identity, "
        "multi-tab IDs, reload, reconnect, and local erase preview"
    )


if __name__ == "__main__":
    main()
